generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Client
  Artisan
}

enum ServiceStatus {
  Open
  Assigned
  Completed
}

enum BidStatus {
  Pending
  Counter_Offered
  Accepted
  Rejected
}

enum EscrowStatus {
  Pending
  Funded
  Released
  Disputed
}

model Users {
  uuid              String             @id @default(uuid()) @db.Uuid
  FullName          String
  Email             String             @unique
  Role              Role             
  PasswordHash      String
  KYC_Verified      Boolean            @default(false)
  WTA_Score         Float              @default(0.0)
  
  Service_Requests  Service_Requests[] 
  Bids              Bids[]             
  ReviewsGiven      Reviews[]          @relation("ClientReviews")
  ReviewsReceived   Reviews[]          @relation("ArtisanReviews")

  kycDetails        KycSubmission?

  CreatedAt         DateTime           @default(now())
  UpdatedAt         DateTime           @updatedAt
}

model Service_Requests {
  RequestID           String                @id @default(uuid()) @db.Uuid
  ClientID            String                @db.Uuid
  Client              Users                 @relation(fields: [ClientID], references: [uuid])
  Description         String
  LocationCoordinates String
  PriceRange          String  
  Status              ServiceStatus         @default(Open) 
  ClientCompleted     Boolean               @default(false)
  ArtisanCompleted    Boolean               @default(false)
  
  Bids                Bids[]
  Escrow_Transaction  Escrow_Transactions?
  Reviews             Reviews[]

  CreatedAt           DateTime              @default(now())
  UpdatedAt           DateTime              @updatedAt
}

model Bids {
  BidID         String           @id @default(uuid()) @db.Uuid
  RequestID     String           @db.Uuid
  Service       Service_Requests @relation(fields: [RequestID], references: [RequestID])
  ArtisanID     String           @db.Uuid
  Artisan       Users            @relation(fields: [ArtisanID], references: [uuid])
  
  ProposedPrice Decimal          
  Message       String           
  CounterAmount Decimal?         
  BidStatus     BidStatus        @default(Pending) 

  CreatedAt     DateTime         @default(now())
  UpdatedAt     DateTime         @updatedAt
}

model Escrow_Transactions {
  TransactionID String           @id @default(uuid()) @db.Uuid
  RequestID     String           @unique @db.Uuid
  Service       Service_Requests @relation(fields: [RequestID], references: [RequestID])
  AmountHeld    Decimal          
  EscrowStatus  EscrowStatus     @default(Pending) 

  CreatedAt     DateTime         @default(now())
  UpdatedAt     DateTime         @updatedAt
}

model Reviews {
  ReviewID   String           @id @default(uuid()) @db.Uuid
  RequestID  String           @db.Uuid
  Service    Service_Requests @relation(fields: [RequestID], references: [RequestID])
  ClientID   String           @db.Uuid
  Client     Users            @relation("ClientReviews", fields: [ClientID], references: [uuid])
  ArtisanID  String           @db.Uuid
  Artisan    Users            @relation("ArtisanReviews", fields: [ArtisanID], references: [uuid])
  
  Rating     Int              
  Comment    String?          
  CreatedAt  DateTime         @default(now())
  UpdatedAt  DateTime         @updatedAt
}

// Stores the secure Cloudinary URLs
model KycSubmission {
  id            String   @id @default(uuid()) @db.Uuid
  userUuid      String   @unique @db.Uuid
  user          Users    @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  
  ninUrl        String?  
  profilePicUrl String?
  businessCert  String?  
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}